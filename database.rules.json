{
  "rules": {
    "roomIndex": {
      ".read": "auth != null && query.orderByKey == true && query.endAt <= (now - 86400000) + ''",
      "$key": {
        ".write": "auth != null && ((!data.exists() && $key === root.child('rooms/'+newData.val()+'/createdAt').val() + '_' + newData.val()) || (!newData.exists() && (!root.child('rooms/'+data.val()).exists() || $key < (now - 86400000) + '')))"
      }
    },
    "rooms": {
      "$code": {
        ".write": "auth != null && !newData.exists() && (root.child('rooms/'+$code+'/memberUids/'+auth.uid).exists() || data.child('createdAt').val() < now - 86400000)",
        "createdAt": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists()"
        },
        "open": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).exists()"
        },
        "memberUids": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.val() === newData.val())"
          }
        },
        "claims": {
          ".read": "auth != null",
          "$playerId": {
            ".write": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).val() === $playerId && (!data.exists() || data.val() === auth.uid)"
          }
        },
        "assignments": {
          "$playerId": {
            ".read": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).val() !== $playerId",
            ".write": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).val() !== $playerId"
          }
        },
        "secrets": {
          "$playerId": {
            ".read": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).val() === $playerId",
            ".write": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).exists()"
          }
        },
        "state": {
          ".read": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).exists()",
          ".write": "auth != null && root.child('rooms/'+$code+'/memberUids/'+auth.uid).exists()"
        }
      }
    }
  }
}
