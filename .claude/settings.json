{
  "permissions": {
    "deny": [
      "Read(./seedProfiles.js)",
      "Read(./public/facts/pack-*.json)",
      "Read(./public/casts/**)",
      "Read(./package-lock.json)",
      "Read(./.anilist-cache/**)",
      "Read(./.facts-cache/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-edit.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the edit"
          }
        ]
      }
    ]
  }
}
