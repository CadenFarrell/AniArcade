{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "site": "aniarcade",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "site": "aniguess-a08f7",
      "public": "hosting/old-address",
      "redirects": [
        { "source": "/", "destination": "https://aniarcade.web.app/", "type": 301 },
        { "source": "/:path*", "destination": "https://aniarcade.web.app/:path", "type": 301 }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
